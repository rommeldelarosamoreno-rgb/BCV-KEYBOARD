<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- Barra Superior: Calculadora / Predicción -->
    <LinearLayout
        android:id="@+id/calculatorBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#E0E6E9"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvCalcPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calculadora lista (ej: 5*10)"
            android:textColor="#1C2B33"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Área Principal de Teclas (Representación Básica) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ÁREA DE TECLAS QWERTY ]"
            android:textColor="#78909C"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Fila Inferior: Botones BCV y Binance (Debajo del espacio) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:weightSum="3"
        android:background="#ECEFF1">

        <!-- Botón USD BCV -->
        <Button
            android:id="@+id/btnUsdBcv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="💵 USD BCV"
            android:textSize="12sp"
            android:textColor="#1C2B33"
            android:backgroundTint="#E0E6E9" />

        <!-- Botón EUR BCV -->
        <Button
            android:id="@+id/btnEurBcv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="💶 EUR BCV"
            android:textSize="12sp"
            android:textColor="#1C2B33"
            android:backgroundTint="#E0E6E9" />

        <!-- Botón Binance P2P (Premium) -->
        <Button
            android:id="@+id/btnBinanceP2p"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="🟡 Binance"
            android:textSize="12sp"
            android:textColor="#1E2329"
            android:backgroundTint="#F0B90B" />
    </LinearLayout>

</LinearLayout>
