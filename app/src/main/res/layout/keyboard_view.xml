<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ECEFF1"
    android:padding="4dp">

    <!-- Fila de tasas: Dólar, Euro y Binance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_dolar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Dólar"
            android:textSize="12sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_euro"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Euro"
            android:textSize="12sp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_binance"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Binance"
            android:textSize="12sp"
            android:backgroundTint="#F57F17"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Teclado Alfanumérico Nativo -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@android:drawable/btn_default"
        android:keyTextColor="#000000"
        android:labelTextSize="14sp"
        android:keyTextSize="18sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
