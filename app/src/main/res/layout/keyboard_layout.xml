<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E3E5E8"
    android:padding="4dp">

    <!-- Fila de tasas con el estilo de botones de Samsung -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_dolar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Dólar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            android:textColor="#333333"
            android:elevation="1dp"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btn_euro"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Euro"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            android:textColor="#333333"
            android:elevation="1dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btn_binance"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Binance"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            android:textColor="#333333"
            android:elevation="1dp"
            android:layout_marginStart="3dp"/>
    </LinearLayout>

    <!-- Vista completa del teclado QWERTY -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E3E5E8"
        android:keyBackground="@android:drawable/btn_default"
        android:keyTextColor="#000000"
        android:keyTextSize="18sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
